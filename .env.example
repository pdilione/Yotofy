# Spotipy (Spotify OAuth) credentials read by backend/sync.py
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback
SPOTIPY_PLAYLIST_IDS=

# Yoto Developer API OAuth credentials for 4-step MYO sync
YOTO_CLIENT_ID=
YOTO_CLIENT_SECRET=
YOTO_REDIRECT_URI=http://127.0.0.1:8000/api/auth/yoto/callback
YOTO_ACCESS_TOKEN=
YOTO_CARD_ID=

# Optional Frontend Redirect URL after OAuth callback
FRONTEND_URL=http://localhost:3000

# Optional Zotify (librespot) session credentials
ZOTIFY_CREDENTIALS_JSON=
ZOTIFY_CREDENTIALS_PATH=data/credentials.json

# Server-side Gemini API key
GEMINI_API_KEY=
